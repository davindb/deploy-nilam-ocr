# Local secrets for scripts/. Copy to .env (git-ignored) and fill in:
#   cp .env.example .env
# Anything set here or in the shell overrides environments/<env>.env.

# Nexus account the cluster pulls images with (Secret $PULL_SECRET). Use a service/robot account, not a
# personal one: nodes reuse this Secret every time a pod is rescheduled, long after the deploy.
# Empty = the Secret must already exist in the namespace.
NEXUS_USERNAME=
NEXUS_PASSWORD=

# Optional: deploy as another GCP service account.
# IMPERSONATE_SA=deployer@ddb-kubecluster-dev-01.iam.gserviceaccount.com

# Optional: helm wait timeout (default 10m).
# HELM_TIMEOUT=10m
